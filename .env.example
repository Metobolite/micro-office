# Browser-safe Supabase project URL and publishable/legacy anon key.
# Never use a secret key or service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used for invitation links. Set your HTTPS domain in production.
# Vercel's VERCEL_URL is used when APP_URL is absent.
APP_URL=http://localhost:3000

# Optional invitation email delivery. Configure both values to enable it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
